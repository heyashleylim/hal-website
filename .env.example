# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values. Used by api/waitlist.js (NSMB waitlist → ActiveCampaign).
AC_API_URL=https://YOURACCOUNT.api-us1.com
AC_API_KEY=
AC_TAG=signup_waitlist_nsmb
AC_LIST_NAME=Master Contact List
# Double opt-in (optional): an ActiveCampaign form that subscribes to Master Contact List with opt-in confirmation ON
AC_FORM_ACTION=https://YOURACCOUNT.activehosted.com/proc.php
AC_FORM_ID=
AC_FORM_U=
AC_FORM_OR=
# Waitlist v2 (docs/waitlist.md). Random, 32+ characters: signs the personal links (/waitlist?c=…). Never change it once links are sent.
WAITLIST_SECRET=
# Random, 24+ characters: ManyChat sends it in the X-Waitlist-Key header (Production).
WAITLIST_MANYCHAT_KEY=

# Private podcast (docs/podcast-plan.md). Uses AC_API_URL / AC_API_KEY above too.
# DATABASE_URL is added by the Neon integration (Vercel → Storage); locally put it in .env.local.
DATABASE_URL=
# Random, at least 32 characters (e.g. `openssl rand -base64 48`). Used to hash IPs; changing it resets "distinct networks" counts.
PODCAST_SECRET=
# Login for /admin/* (separate from the /preview login)
ADMIN_USER=
ADMIN_PASSWORD=
# Phase 5 (ActiveCampaign automation)
# Any long random text: secures the daily job (Vercel Cron sends it). Production.
CRON_SECRET=
# Optional: another address for students' links. Default on production: https://www.ashleylim.com.
PODCAST_PUBLIC_URL=
# Optional: the AC contact field (personalization tag) that receives each student's personal page. Default PODCAST_LINK.
AC_FIELD_PODCAST_LINK=

# Preview only (never Production): the Neon branch previews use, a copy of production's data.
# Without it, the preview admin refuses changes. Locally, add it to .env.local for npm run db:migrate:preview.
PODCAST_DATABASE_URL=

# Shop (docs/commerce-plan.md). Needed from phase 2 (checkout) on; /admin/shop/settings shows which are present.
# CiderPay merchant id and API token (card payments in KRW)
CIDERPAY_MEMBER_ID=
CIDERPAY_API_TOKEN=
# PayPal REST app (USD). Previews: sandbox credentials.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# Random, at least 32 characters: signs payment notices, order links and sign-in links. Never change it once live.
SHOP_SECRET=
# Slack incoming webhooks for payment, refund and failed-instalment alerts (either or both)
SLACK_WEBHOOK_ASHLEY=
SLACK_WEBHOOK_ALEX=
