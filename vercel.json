{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/podcast-page.js": {
      "includeFiles": "site/{index.html,nsmb/index.html}"
    }
  },
  "crons": [
    {
      "path": "/api/admin?action=cron",
      "schedule": "10 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/preview/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/podcast/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "product"
        }
      ],
      "destination": "https://ashleylim.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "add-to-cart"
        }
      ],
      "destination": "https://ashleylim.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "wc-api"
        }
      ],
      "destination": "https://ashleylim.com/",
      "permanent": true
    },
    {
      "source": "/checkout/:path*",
      "destination": "https://ashleylim.com/checkout/:path*",
      "permanent": true
    },
    {
      "source": "/cart/:path*",
      "destination": "https://ashleylim.com/cart/:path*",
      "permanent": true
    },
    {
      "source": "/my-account/:path*",
      "destination": "https://ashleylim.com/my-account/:path*",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "https://ashleylim.com/wp-admin/:path*",
      "permanent": true
    },
    {
      "source": "/wp-json/:path*",
      "destination": "https://ashleylim.com/wp-json/:path*",
      "permanent": true
    },
    {
      "source": "/wp-content/:path*",
      "destination": "https://ashleylim.com/wp-content/:path*",
      "permanent": true
    },
    {
      "source": "/product/:path*",
      "destination": "https://ashleylim.com/product/:path*",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "https://ashleylim.com/shop",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "https://ashleylim.com/wp-login.php",
      "permanent": true
    },
    {
      "source": "/lifeartist2026",
      "destination": "/lifeartist",
      "permanent": true
    },
    {
      "source": "/preview/lifeartist2026",
      "destination": "/preview/lifeartist",
      "permanent": true
    },
    {
      "source": "/go/instagram",
      "destination": "https://www.instagram.com/heyashleylim",
      "permanent": false
    },
    {
      "source": "/go/threads",
      "destination": "https://www.threads.com/@heyashleylim",
      "permanent": false
    },
    {
      "source": "/go/youtube",
      "destination": "https://www.youtube.com/@heyashleylim",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/f/:token([A-Za-z0-9_-]+)/:show([a-z0-9-]+)",
      "destination": "/api/podcast-feed?token=:token&show=:show"
    },
    {
      "source": "/f/:token([A-Za-z0-9_-]+)",
      "destination": "/api/podcast-feed?token=:token"
    },
    {
      "source": "/a/:token([A-Za-z0-9_-]+)/:file",
      "destination": "/api/podcast-audio?token=:token&file=:file"
    },
    {
      "source": "/podcast/:token([A-Za-z0-9_-]+)",
      "destination": "/api/podcast-page?token=:token"
    }
  ]
}
