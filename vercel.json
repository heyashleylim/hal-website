{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/preview/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "product"
        }
      ],
      "destination": "https://ashleylim.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "add-to-cart"
        }
      ],
      "destination": "https://ashleylim.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "wc-api"
        }
      ],
      "destination": "https://ashleylim.com/",
      "permanent": true
    },
    {
      "source": "/checkout/:path*",
      "destination": "https://ashleylim.com/checkout/:path*",
      "permanent": true
    },
    {
      "source": "/cart/:path*",
      "destination": "https://ashleylim.com/cart/:path*",
      "permanent": true
    },
    {
      "source": "/my-account/:path*",
      "destination": "https://ashleylim.com/my-account/:path*",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "https://ashleylim.com/wp-admin/:path*",
      "permanent": true
    },
    {
      "source": "/wp-json/:path*",
      "destination": "https://ashleylim.com/wp-json/:path*",
      "permanent": true
    },
    {
      "source": "/wp-content/:path*",
      "destination": "https://ashleylim.com/wp-content/:path*",
      "permanent": true
    },
    {
      "source": "/product/:path*",
      "destination": "https://ashleylim.com/product/:path*",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "https://ashleylim.com/shop",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "https://ashleylim.com/wp-login.php",
      "permanent": true
    },
    {
      "source": "/lifeartist2026",
      "destination": "/lifeartist",
      "permanent": true
    },
    {
      "source": "/preview/lifeartist2026",
      "destination": "/preview/lifeartist",
      "permanent": true
    },
    {
      "source": "/go/instagram",
      "destination": "https://www.instagram.com/heyashleylim",
      "permanent": false
    },
    {
      "source": "/go/threads",
      "destination": "https://www.threads.com/@heyashleylim",
      "permanent": false
    },
    {
      "source": "/go/youtube",
      "destination": "https://www.youtube.com/@heyashleylim",
      "permanent": false
    }
  ]
}
